# Tennis Dashboard — environment variables
# Copy this file to `.env` (which is gitignored) and fill in your real values.

# ── Matchstat (Tennis API on RapidAPI) ───────────────────────────────────────
# Subscribe at: https://rapidapi.com/jjrm365-kIFr3Nx_odV/api/tennis-api-atp-wta-itf
# After subscribing, find your key under "Endpoints" → "Header Parameters".
MATCHSTAT_API_KEY=your_rapidapi_key_here
MATCHSTAT_API_HOST=tennis-api-atp-wta-itf.p.rapidapi.com

# RapidAPI app metadata (optional — for tracking / multi-key support)
# RAPIDAPI_APP_ID=
# RAPIDAPI_USER=

# ── Cloudflare R2 (private store for data/tennis.db.gz) ──────────────────────
# The DB snapshot contains raw Matchstat API payloads that ToS prohibits
# redistributing publicly. R2 is the canonical store; the local .gz is a
# gitignored cache. Provision the bucket + an API token at:
#   https://dash.cloudflare.com → R2 → Manage R2 API Tokens (scope: Object R/W)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_BUCKET=tennis-snapshots
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key

# ── Cloudflare Worker admin sync token (POST /api/admin/sync) ────────────────
# Same value must be set as a Workers Secret (wrangler secret put) and a
# GitHub Actions repo secret. Used by scripts/upload_to_worker.py.
ADMIN_SYNC_TOKEN=your_admin_token
