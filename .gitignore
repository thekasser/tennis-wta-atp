# SQLite working DB and snapshot — both gitignored since 2026-05-24.
# tennis.db.gz contains raw Matchstat API payloads (matches.raw, stat_p1,
# stat_p2) that the RapidAPI ToS prohibits redistributing publicly.
# Canonical store: private R2 bucket. See scripts/r2.py and CLAUDE.md.
data/tennis.db
data/tennis.db.gz
data/tennis.db-journal
data/tennis.db-wal
data/tennis.db-shm

# D1 seed artifacts (regeneratable from data/tennis.db via scripts/export_for_d1.py)
workers/seed/

# Wrangler build/state — `.wrangler/` at repo root has wrangler-account.json
# with credentials (NEVER commit)
.wrangler/
workers/.wrangler/
workers/dist/
workers/node_modules/

