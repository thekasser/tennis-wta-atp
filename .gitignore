# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon

# Editors
.vscode/
.idea/
*.swp
*~

# Python
__pycache__/
*.pyc
*.pyo
.Python
*.egg-info/
.venv/
venv/

# Secrets — NEVER commit
.env
.env.local
.env.*.local
*.pem
*.key
secrets/

# Cached match-level data — large, fetched on-demand from Sackmann's repos
scripts/cache/
*.csv

# Allow specific data files we DO commit (recompute outputs, not raw inputs)
!data/*.js

# SQLite working DB — committed snapshot is data/tennis.db.gz only
data/tennis.db
data/tennis.db-journal
data/tennis.db-wal
data/tennis.db-shm

# D1 seed artifacts (regeneratable from data/tennis.db via scripts/export_for_d1.py)
workers/seed/

# Wrangler build/state — `.wrangler/` at repo root has wrangler-account.json
# with credentials (NEVER commit)
.wrangler/
workers/.wrangler/
workers/dist/
workers/node_modules/

# Local dev artifacts
*.log
node_modules/

# Claude/Cowork local state (paranoia — these don't usually live in workspace folders, but in case)
.claude/
.cowork/
